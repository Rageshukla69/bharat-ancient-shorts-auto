name: Automated Bharat Ancient History & Mythology Hindi Shorts (Every 12 Hours — HyperFrames v11.0 + 10 MAI Images)

on:
  schedule:
    # Primary 12-hour slots at off-peak minute :25 (6:55 AM IST & 6:55 PM IST)
    # + Backup catch-up slots (9:55 AM IST & 9:55 PM IST) so GitHub queue congestion can NEVER skip a run!
    - cron: '25 1,4,13,16 * * *'
  workflow_dispatch:
    inputs:
      custom_topic:
        description: 'Optional custom Ancient India / Mythology / Temple Wonder topic (leave blank to auto-pick next unused topic)'
        required: false
        default: ''
      max_ai_images:
        description: 'Maximum MAI-Image-2.6-Flash images per Short (default 10 for full 9:16 cinema quality)'
        required: false
        default: '10'
      bg_music_volume:
        description: 'Background music volume (default 0.40)'
        required: false
        default: '0.40'
      render_engine:
        description: 'Video rendering engine (hyperframes = HTML/GSAP/Shader + FFmpeg hybrid, ffmpeg = direct FFmpeg)'
        required: false
        default: 'hyperframes'
      dry_run:
        description: 'Skip YouTube upload (true = render & preview MP4 only, false = upload to YouTube)'
        required: false
        default: 'false'

permissions:
  contents: write
  actions: write

concurrency:
  group: bharat-hindi-shorts-pipeline
  cancel-in-progress: false

jobs:
  generate-and-upload-short:
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up System Dependencies (FFmpeg, Hindi Devanagari Fonts & Chromium Headless Deps)
        run: |
          sudo apt-get update
          sudo apt-get install -y ffmpeg fonts-noto-core fonts-noto-unhinted fonts-indic fonts-lohit-deva fonts-montserrat fonts-liberation fonts-dejavu-core libmagic1 libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxrandr2 libgbm1 libasound2t64 || sudo apt-get install -y ffmpeg fonts-noto-core fonts-noto-unhinted fonts-indic fonts-lohit-deva fonts-montserrat fonts-liberation fonts-dejavu-core libmagic1
          fc-cache -f -v

      - name: Set up Node.js 22 for HyperFrames Engine
        uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: Install HyperFrames CLI Engine
        run: |
          npm install --no-audit --no-fund || npm install -g hyperframes || true

      - name: Set up Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'

      - name: Install Python Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Prepare Uplifting Documentary Score
        run: |
          python src/sfx_generator.py

      - name: Run End-to-End Ancient India & Mythology Hindi Short Pipeline (HyperFrames v11.0 + 10 MAI Images + 0.40 BGM)
        env:
          GITHUB_EVENT_NAME: ${{ github.event_name }}
          AZURE_SPEECH_KEY: ${{ secrets.AZURE_SPEECH_KEY }}
          AZURE_SPEECH_REGION: ${{ secrets.AZURE_SPEECH_REGION || 'centralindia' }}
          AZURE_TTS_VOICE: 'hi-IN-RehaanNeural'
          BG_MUSIC_VOLUME: ${{ github.event.inputs.bg_music_volume || '0.40' }}
          BGM_URL: ${{ secrets.BGM_URL || '' }}
          FOUNDRY_API_KEY: ${{ secrets.FOUNDRY_API_KEY }}
          FOUNDRY_ENDPOINT: ${{ secrets.FOUNDRY_ENDPOINT }}
          FOUNDRY_IMAGE_MODEL: ${{ secrets.FOUNDRY_IMAGE_MODEL || 'MAI-Image-2.6-Flash' }}
          MAX_AI_IMAGES_PER_SHORT: ${{ github.event.inputs.max_ai_images || '10' }}
          RENDER_ENGINE: ${{ github.event.inputs.render_engine || 'hyperframes' }}
          FOUNDRY_TEXT_API_KEY: ${{ secrets.FOUNDRY_TEXT_API_KEY }}
          FOUNDRY_TEXT_ENDPOINT: ${{ secrets.FOUNDRY_TEXT_ENDPOINT }}
          FOUNDRY_TEXT_MODEL: ${{ secrets.FOUNDRY_TEXT_MODEL || 'gpt-6-luna' }}
          SHORTS_PER_DAY: ${{ secrets.SHORTS_PER_DAY || '2' }}
          VOICE_SPEED_PERCENT: '0'
          YOUTUBE_TOKEN_JSON: ${{ secrets.YOUTUBE_TOKEN_JSON }}
          PEXELS_API_KEY: ${{ secrets.PEXELS_API_KEY }}
          CUSTOM_TOPIC: ${{ github.event.inputs.custom_topic }}
          DRY_RUN: ${{ github.event.inputs.dry_run || 'false' }}
        run: |
          python src/main.py

      - name: Upload Rendered Short & HyperFrames Bundle as Workflow Artifact
        uses: actions/upload-artifact@v4
        if: always() && hashFiles('output/final_short.mp4') != ''
        with:
          name: bharat-hindi-short-${{ github.run_id }}
          path: |
            output/final_short.mp4
            output/subtitles.ass
            output/metadata.json
            output/hyperframes_project/index.html
            output/hyperframes_project/preview.html
            output/hyperframes_project/DESIGN.md
          retention-days: 7

      - name: Commit Updated Topic Queue & History State (Backup Sync)
        if: always() && github.event.inputs.dry_run != 'true'
        run: |
          git config --local user.email "actions@github.com"
          git config --local user.name "Bharat Ancient Shorts Bot"
          git add data/topics_seed.json data/used_topics.json data/upload_history.json
          if ! git diff --staged --quiet; then
            git commit -m "chore: record completed ancient india hindi short [skip ci]"
          fi
          for i in 1 2 3; do
            git pull --rebase --autostash origin main && git push origin HEAD:main && break
            sleep 2
          done
